{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{index.html,app.js,community.js,map.js,styles.css,assets/**,data/*.json}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api?__path=$1"
    }
  ]
}
